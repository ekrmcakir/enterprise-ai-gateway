# Enterprise AI Gateway Environment Variables

# Core Server Settings
APP_NAME="Enterprise AI Gateway & Semantic Firewall"
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Authentication & Keys
MASTER_API_KEY=sk-gw-admin-secret
ALLOWED_API_KEYS=["sk-gw-admin-secret","sk-gw-test-client","sk-gw-finops-demo"]

# Upstream LLM Provider Credentials
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

OLLAMA_BASE_URL=http://localhost:11434

ENABLE_MOCK_FALLBACK=true

# Semantic Firewall
FIREWALL_ENABLED=true
BLOCK_PROMPT_INJECTIONS=true
INJECTION_SENSITIVITY_THRESHOLD=0.70
PII_MASKING_ENABLED=true
OUTPUT_GUARD_ENABLED=true

# Semantic Caching
CACHE_ENABLED=true
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_TTL_SECONDS=3600
USE_REDIS=false
REDIS_URL=redis://localhost:6379/0

# FinOps & Rate Limiting
RATE_LIMIT_ENABLED=true
DEFAULT_RPM=60
DEFAULT_TPM=100000
DEFAULT_MONTHLY_BUDGET_USD=50.0

# Observability
ENABLE_PROMETHEUS=true
OTEL_SERVICE_NAME=enterprise-ai-gateway
